{
  "name": "thesite",
  "version": "0.0.0",
  "private": true,
  "description": "The project site of the theplanet-earth organization, with the harness of thebox: devcontainer, conventions for people and for Claude Code, git hooks, checks and releases.",
  "scripts": {
    "build": "bash scripts/build.sh",
    "serve": "bash scripts/serve.sh",
    "test": "bash scripts/test.sh",
    "check": "bash scripts/check.sh",
    "check:confidential": "python3 scripts/check-confidential.py --all",
    "check:template": "bash scripts/check-template.sh",
    "check:site": "python3 scripts/check-site.py",
    "globe:land": "python3 scripts/land-mask.py",
    "setup:python": "bash scripts/setup-python.sh",
    "version:current": "python3 scripts/version.py current",
    "version:next": "python3 scripts/version.py next",
    "release:notes": "python3 scripts/version.py notes",
    "clean": "rm -rf build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "three": "0.187.0"
  }
}
