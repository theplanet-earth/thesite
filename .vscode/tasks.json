{
  // Every command of the repository as a task (Terminal, Run Task): the npm scripts of
  // package.json.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview: site (live reload)",
      "detail": "Jekyll serves docs/ at http://localhost:4000 and rebuilds on every change (npm run serve); stop it with Ctrl+C or Terminate Task",
      "type": "npm",
      "script": "serve",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "Every output in build/ (build/release/ for the release, build/pages/ for GitHub Pages)",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Check: everything",
      "detail": "Tests, confidentiality, TEMPLATE markers and the checks of the repository, as CI runs them",
      "type": "npm",
      "script": "check",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    { "label": "Check: unit tests", "type": "npm", "script": "test", "group": "test", "problemMatcher": [] },
    { "label": "Check: confidentiality", "type": "npm", "script": "check:confidential", "group": "test", "problemMatcher": [] },
    { "label": "Check: site (build/pages/)", "detail": "Every local link and resource of the built site exists (npm run build first)", "type": "npm", "script": "check:site", "group": "test", "problemMatcher": [] },
    { "label": "Check: TEMPLATE markers left", "type": "shell", "command": "npm run check:template -- --list", "group": "test", "problemMatcher": [] },
    { "label": "Globe: land mask", "detail": "docs/assets/globe/land.png from Natural Earth (npm run globe:land)", "type": "npm", "script": "globe:land", "problemMatcher": [] },
    { "label": "Python: set up .venv", "type": "npm", "script": "setup:python", "problemMatcher": [] },
    { "label": "Release: next version", "type": "npm", "script": "version:next", "problemMatcher": [] },
    { "label": "Release: notes preview", "type": "npm", "script": "release:notes", "problemMatcher": [] },
    { "label": "Clean", "type": "npm", "script": "clean", "problemMatcher": [] }
  ]
}
