// The Worker of production, thesite, at theplanet.observer (issue #2). Cloudflare serves the
// site built by npm run build (build/pages/) as static assets, free and without running the
// script; the script (worker/index.js) runs only for /api/*, the latest edits of
// OpenStreetMap, read at most every 19 minutes and cached. The custom domain creates its DNS
// record and certificate on the first deploy, on a zone whose apex has no record of its own
// (issue #6). The account and the token come from the environment of the deploy
// (CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN), never from this file.
// https://developers.cloudflare.com/workers/static-assets/
// https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
{
  "name": "thesite",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./build/pages",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "theplanet.observer", "custom_domain": true }
  ]
}
