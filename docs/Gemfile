# The gems of the site: Jekyll 4.3 on Ruby 3.3 (CLAUDE.md, Section 10); Gemfile.lock pins them.
# Run Jekyll through the npm scripts (npm run build, npm run serve), which use this file.
source "https://rubygems.org"

gem "jekyll", "~> 4.3.3"

# Default gems of Ruby 3.3 that stop being default in Ruby 3.4; Jekyll 4.3 and its gems load
# them, and Ruby 3.3 warns at every build until they are in the bundle. Pinned to the versions
# Ruby 3.3 ships, so that nothing is downloaded or compiled.
gem "base64", "0.2.0"
gem "bigdecimal", "3.1.5"
gem "csv", "3.2.8"

# Windows and JRuby do not include zoneinfo files, so bundle the tzinfo-data gem.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Faster watching of directories on Windows.
gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]

# http_parser.rb 0.6 on JRuby, since newer versions have no Java counterpart.
gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
