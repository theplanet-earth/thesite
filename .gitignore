# Every output is built in build/ (scripts/build.sh) and published by the release
# workflow: never commit it.
/build/
# Tooling
node_modules/
/.venv/
/.playwright-mcp/
__pycache__/
*.py[cod]
# Private material (also blocked by the confidentiality hook): confidential-terms.local,
# *.local.* notes, environment files, keys, private folders
*.local
*.local.*
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
private/
# Copies of this file left by a download or an upload, such as "CLAUDE (1).md"
/CLAUDE (*).md
# Jekyll and Bundler, when run by hand in docs/ (the scripts write to build/ only)
/docs/_site/
/docs/.jekyll-cache/
/docs/.jekyll-metadata
/docs/.bundle/
/docs/vendor/
