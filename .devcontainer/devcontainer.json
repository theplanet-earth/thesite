{
  // thesite: Ruby 3.3 for the site (Jekyll), the same minor version as the workflows
  // (ruby/setup-ruby); the preview of npm run serve on port 4000, live reload on 35729.
  // TEMPLATE: the extensions of the tools of this repository (keep .vscode/extensions.json
  // identical).
  "name": "thesite",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "EXTRA_PACKAGES": ""
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/ruby:1": { "version": "3.3" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Site preview (npm run serve)", "onAutoForward": "openPreview" },
    "35729": { "label": "Live reload", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "mhutchie.git-graph",
        "github.vscode-github-actions",
        "bierner.markdown-mermaid",
        "streetsidesoftware.code-spell-checker",
        "ms-python.python"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md", "CLAUDE.md"],
      // Read access to every repository of the organization, granted when the Codespace is
      // created (CLAUDE.md, Known issues).
      "repositories": {
        "theplanet-earth/*": {
          "permissions": "read-all"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
