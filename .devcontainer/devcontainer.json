{
  // thesite: Ruby 3.3 for the site (Jekyll), the same minor version as the workflows
  // (ruby/setup-ruby); the preview of npm run serve on port 4000, live reload on 35729.
  // The tools of this repository (Jekyll, three.js through esbuild, Python and Node tests) need
  // no extension beyond those of the harness (keep .vscode/extensions.json identical).
  "name": "thesite",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "EXTRA_PACKAGES": ""
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/ruby:1": { "version": "3.3" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Site preview (npm run serve)", "onAutoForward": "openPreview" },
    "35729": { "label": "Live reload", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "mhutchie.git-graph",
        "github.vscode-github-actions",
        "bierner.markdown-mermaid",
        "streetsidesoftware.code-spell-checker",
        "ms-python.python"
      ]
    },
    "codespaces": {
      "openFiles": ["README.md", "CLAUDE.md"],
      // Access to every other repository of the organization, requested when a Codespace is
      // created and granted only if the user authorizes it (the caution at the top of
      // README.md lists what it allows). Read on everything, write on issues only: from here
      // an assistant asks for a change in another repository with an issue, never by pushing
      // to it (the owner's instruction of 2026-11-24, CLAUDE.md Section 2). Without write on
      // contents it cannot push a branch there. GitHub accepts "read-all" or a list, not
      // both; the names and values are those of
      // https://docs.github.com/en/codespaces/managing-your-codespaces/managing-repository-access-for-your-codespaces
      "repositories": {
        "theplanet-earth/*": {
          "permissions": {
            "actions": "read",
            "checks": "read",
            "contents": "read",
            "deployments": "read",
            "discussions": "read",
            "issues": "write",
            "packages": "read",
            "pages": "read",
            "pull_requests": "read",
            "repository_projects": "read",
            "statuses": "read"
          }
        }
      }
    }
  },
  "remoteUser": "vscode"
}
